# Recreate legacy paths only for existing project-owned resources.
function(iiv_compat_links resource_root build_root)
    if(IS_SYMLINK "${resource_root}" OR IS_SYMLINK "${build_root}")
        message(FATAL_ERROR "Resource and build roots must be direct directories")
    endif()
    file(REAL_PATH "${resource_root}" resource_real)
    set(pairs "images|images" "instances|vm" "vms|vms" "gb|gb"
        "mv|guest-build/multi" "fsv|guest-build/sandbox" "ob|ob"
        "dependencies|dependencies" "guest-upgrades|guest-upgrades"
        "qemu-display|dependencies/qemu-display" "os-boot|guest-build/os-boot"
        "build-layer|build-layer")
    foreach(pair IN LISTS pairs)
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 name)
        list(GET parts 1 relative)
        set(target "${resource_root}/${relative}")
        if(IS_SYMLINK "${target}")
            message(FATAL_ERROR "Resource target must be a direct directory: ${target}")
        endif()
        if(NOT IS_DIRECTORY "${target}")
            continue()
        endif()
        file(REAL_PATH "${target}" target_real)
        cmake_path(IS_PREFIX resource_real "${target_real}" NORMALIZE inside)
        if(NOT inside)
            message(FATAL_ERROR "Resource target escapes its root: ${target}")
        endif()
        set(link "${build_root}/${name}")
        if(IS_SYMLINK "${link}")
            file(REAL_PATH "${link}" existing_real)
            if(NOT existing_real STREQUAL target_real)
                message(FATAL_ERROR "Existing compatibility link targets another path: ${link}")
            endif()
        elseif(EXISTS "${link}")
            message(FATAL_ERROR "Existing build data must be preserved: ${link}")
        else()
            file(RELATIVE_PATH relative_target "${build_root}" "${target_real}")
            file(CREATE_LINK "${relative_target}" "${link}" SYMBOLIC RESULT result)
            if(NOT result STREQUAL "0")
                message(FATAL_ERROR "Cannot create compatibility link ${link}: ${result}")
            endif()
        endif()
    endforeach()
endfunction()
