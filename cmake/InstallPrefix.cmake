# Keep default SDK installation separate from build artifacts.
function(iiv_set_install_prefix)
    if(NOT PROJECT_IS_TOP_LEVEL OR NOT CMAKE_INSTALL_PREFIX_INITIALIZED_TO_DEFAULT)
        return()
    endif()
    if(NOT "$ENV{HOME}" STREQUAL "")
        set(user_home "$ENV{HOME}")
    elseif(NOT "$ENV{USERPROFILE}" STREQUAL "")
        set(user_home "$ENV{USERPROFILE}")
    else()
        message(FATAL_ERROR "Set CMAKE_INSTALL_PREFIX explicitly when no user home is available")
    endif()
    set(CMAKE_INSTALL_PREFIX "${user_home}/.local/SDK/iiVirtualizer" CACHE PATH "Install prefix" FORCE)
endfunction()
