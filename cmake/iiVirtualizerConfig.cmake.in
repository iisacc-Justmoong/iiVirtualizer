@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiSDKCore 0.18 CONFIG COMPONENTS Runtime)
find_dependency(iiJson 0.1 CONFIG)
find_dependency(iiFileProviderNative 0.9 CONFIG)
set(iiVirtualizer_GATEWAY_FOUND @IIVIRTUALIZER_BUILD_GATEWAY@)
if(iiVirtualizer_GATEWAY_FOUND)
    find_dependency(iiNetwork 0.5 CONFIG)
    find_dependency(iiAccountManagerNative 0.2 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/iiVirtualizerTargets.cmake")
